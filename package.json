{
  "name": "@tehkne/storyforge",
  "version": "0.8.0-rc.1",
  "private": true,
  "description": "TEHKNÉ STORYFORGE — idea-to-universe-to-media narrative engine",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate:schema": "node scripts/validate-schema.mjs",
    "validate:semantics": "node scripts/validate-semantics.mjs",
    "validate": "npm run typecheck && npm run validate:schema && npm run validate:semantics && npm run validate:runtime-contracts && npm run validate:canon-timeline && npm run validate:runtime && npm run validate:compiler && npm run validate:media && npm run validate:generation-brief && npm run validate:v0.5 && npm run validate:v0.6 && npm run validate:v0.7 && npm run validate:v0.8 && npm run validate:i18n && npm run validate:narrative-forge && npm run validate:scene-authority && npm run validate:scene-expansion && npm run validate:semantic-authority && npm run validate:visual-novel-runtime && npm run validate:workspace-persistence && npm run validate:native-manga && npm run validate:native-anime && npm run validate:media-equivalence",
    "compile:reference": "node scripts/compile-reference.mjs",
    "validate:compiler": "node scripts/validate-compiler.mjs",
    "validate:runtime-contracts": "node scripts/validate-runtime-contracts.mjs",
    "validate:canon-timeline": "node scripts/validate-canon-timeline.mjs",
    "validate:runtime": "node scripts/validate-runtime.mjs",
    "validate:media": "node scripts/validate-media.mjs",
    "build:brief": "node scripts/build-generation-brief.mjs",
    "validate:generation-brief": "node scripts/validate-generation-brief.mjs",
    "score:decisions": "node scripts/score-decisions.mjs",
    "resolve:narrative": "node scripts/resolve-narrative.mjs",
    "realize:reference": "node scripts/realize-reference.mjs",
    "simulate:event": "node scripts/simulate-event-proposal.mjs",
    "review:canon": "node scripts/review-canon-proposal.mjs",
    "validate:v0.5": "node scripts/validate-v0.5.mjs",
    "dev:story-lab": "npm run dev --workspace @tehkne/story-lab",
    "build:story-lab": "npm run build --workspace @tehkne/story-lab",
    "typecheck:story-lab": "npm run typecheck --workspace @tehkne/story-lab",
    "export:game": "node scripts/export-game-reference.mjs",
    "validate:v0.6": "node scripts/validate-v0.6.mjs",
    "validate:v0.7": "node scripts/validate-v0.7.mjs",
    "validate:v0.8": "node scripts/validate-v0.8.mjs",
    "validate:i18n": "node scripts/validate-i18n.mjs",
    "validate:narrative-forge": "node scripts/validate-narrative-forge-v03.mjs",
    "validate:scene-authority": "node scripts/validate-scene-authority-v04.mjs",
    "validate:scene-expansion": "node scripts/validate-scene-expansion-v041.mjs",
    "validate:semantic-authority": "node scripts/validate-semantic-authority-v042.mjs",
    "validate:visual-novel-runtime": "node scripts/validate-visual-novel-runtime-v043.mjs",
    "validate:workspace-persistence": "node scripts/validate-workspace-persistence-v044.mjs",
    "validate:native-manga": "node scripts/validate-native-manga-v045.mjs",
    "validate:native-anime": "node scripts/validate-native-anime-v046.mjs",
    "validate:media-equivalence": "node scripts/validate-media-equivalence-v047.mjs",
    "validate:story-lab-probes": "npm run validate:probes --workspace=@tehkne/story-lab",
    "quality:story-lab": "npm run validate && npm run validate:story-lab-probes && npm run typecheck:story-lab && npm run build:story-lab"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*"
  ]
}
