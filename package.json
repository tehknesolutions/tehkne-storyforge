{
  "name": "@tehkne/storyforge",
  "version": "0.1.0",
  "private": true,
  "description": "TEHKNÉ STORYFORGE — idea-to-universe-to-media narrative engine",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate:schema": "node scripts/validate-schema.mjs",
    "validate:semantics": "node scripts/validate-semantics.mjs",
    "validate": "npm run typecheck && npm run validate:schema && npm run validate:semantics && npm run validate:runtime-contracts && npm run validate:canon-timeline && npm run validate:runtime && npm run validate:compiler && npm run validate:media && npm run validate:generation-brief && npm run validate:v0.5",
    "compile:reference": "node scripts/compile-reference.mjs",
    "validate:compiler": "node scripts/validate-compiler.mjs",
    "validate:runtime-contracts": "node scripts/validate-runtime-contracts.mjs",
    "validate:canon-timeline": "node scripts/validate-canon-timeline.mjs",
    "validate:runtime": "node scripts/validate-runtime.mjs",
    "validate:media": "node scripts/validate-media.mjs",
    "build:brief": "node scripts/build-generation-brief.mjs",
    "validate:generation-brief": "node scripts/validate-generation-brief.mjs",
    "score:decisions": "node scripts/score-decisions.mjs",
    "resolve:narrative": "node scripts/resolve-narrative.mjs",
    "realize:reference": "node scripts/realize-reference.mjs",
    "simulate:event": "node scripts/simulate-event-proposal.mjs",
    "review:canon": "node scripts/review-canon-proposal.mjs",
    "validate:v0.5": "node scripts/validate-v0.5.mjs"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=22"
  }
}
