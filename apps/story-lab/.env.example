# Storyforge text provider (optional in preview)
OPENAI_API_KEY=
STORYFORGE_OPENAI_MODEL=gpt-5.6

# Explicit cost/safety gate. API key alone does not enable generation.
STORYFORGE_GENERATION_ENABLED=false

# Creator-supplied execution token. Never expose it through provider-status.
STORYFORGE_GENERATION_ACCESS_TOKEN=

# Durable Storyforge backend (Supabase).
# Publishable values are safe for browser use; authorization is enforced by RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Private-by-default account provisioning.
STORYFORGE_SIGNUP_ENABLED=false
